# trading_system environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.
#
# Variables marked (cycle 1) are needed for Phase 0/1.
# Variables marked (cycle 2+) are not used until live broker integration.

# ============================================================================
# Data sources (cycle 1)
# ============================================================================

# Polygon.io free tier (5 calls/min, 2yr history, EOD options)
# Sign up: https://polygon.io
POLYGON_API_KEY=

# Optional alternatives — not used in cycle 1, present for future flexibility
TIINGO_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# ============================================================================
# LLM API keys (research_llm/ only — never reaches the trade gate)
# ============================================================================
# Used by Coder, Critic, Summariser, Analyst, Comms, Verifier roles.
# See metadata/strategic_lock.md for the full role table.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
MOONSHOT_API_KEY=

# ============================================================================
# Broker (cycle 2+, not used in cycle 1)
# ============================================================================
# Cycle 1 uses internal simulation in paper_exec/.
# Cycle 2 may switch to IBKR Pro UK paper account for production realism.

IBKR_USERNAME=
IBKR_PASSWORD=
IBKR_ACCOUNT_TYPE=paper

# ============================================================================
# Operational
# ============================================================================

TRADING_SYSTEM_ENV=development
LOG_LEVEL=INFO
SQLITE_DB_PATH=data/trading_system.db

# Free historical options dataset (philippdubach) location after clone
# Default: data/philippdubach/
PHILIPPDUBACH_DATA_PATH=data/philippdubach
