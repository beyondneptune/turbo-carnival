{
  "name": "athena_v1_lane2_falcon_alpha",
  "version": "v1",
  "description": "Momentum/breakout HFT with marketable-limit IOC + bracket + COMPOSITE C3 gate (union of 016 LOF, 017 OCSVM, 018 EllipticEnvelope, 102 RBF+LogReg) + AE hard veto + vol-inverse sizing. C3 chosen empirically on yesterday's data: +$2,030 Δ counterfactual.",
  "account": "FALCON_PAPER",
  "strategy": "momentum_breakout_v1",
  "symbols": ["SPY", "QQQ", "NVDA"],
  "max_entries_per_day": 25,
  "order": {
    "type": "marketable_limit_ioc_bracket",
    "limit_offset_bps": 3.0,
    "ioc_timeout_sec": 3.0,
    "sl_type": "stop_limit",
    "sl_limit_offset_bps": 3.0
  },
  "position_sizing": {
    "formula": "vol_inverse",
    "base_notional_usd": 12000,
    "target_vol_bps": 15,
    "min_notional_usd": 4000,
    "max_notional_usd": 20000
  },
  "entry_thresholds": {
    "ret5_z_min": 1.4,
    "range_pct_min_pctile": 60,
    "spread_max_bps": 6.0
  },
  "exit_rules": {
    "tp_bps": 30.0,
    "sl_bps": 18.0,
    "time_exit_min": 15
  },
  "ml_kill": {
    "composite_c3_mid_trade_exit": true,
    "ae_recon_exit_pctile": 99
  },
  "filter_cascade": [
    {"type": "time_gate", "params": {"start_et": "10:00", "end_et": "15:30"}},
    {"type": "news_blackout", "params": {"cooldown_sec": 600}},
    {"type": "spread_gate", "params": {"max_bps": 6.0}},
    {"type": "abs_return_gate", "params": {"threshold_bps": 80}},
    {"type": "composite_c3_gate", "params": {"block_if_any_subgate_blocks": true}},
    {"type": "ae_anomaly_gate", "params": {"hard_veto_pctile": 99, "size_down_pctile": 95}},
    {"type": "signal_trigger", "params": {"mode": "momentum_breakout"}},
    {"type": "position_correlation_check", "params": {"max_open": 2}},
    {"type": "lane_conflict_check", "params": {"yields_to": "Aegis"}}
  ],
  "slippage_bps_assumed": 8.0,
  "rollback": {
    "intraday_dd_pause_pct": 1.0,
    "noon_combined_dd_hard_stop_pct": 0.5
  }
}
